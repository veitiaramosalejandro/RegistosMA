# Docker Desktop debe estar en Windows Containers.
RTSP_PORT=18554
WEB_PORT=8881
PUBLIC_HOST=localhost
# En Docker Windows se detecta automáticamente si se deja vacío.
BIND_ADDRESS=
TEST_TONE=false
AUDIO_DEVICE=
AUDIO_AGENT_PORT=8091
AUDIO_AGENT_URL=http://host.docker.internal:8091
AUDIO_CHANNELS=2
AUDIO_BITRATE=192
MEDIAMTX_VERSION=1.15.2
FFMPEG_URL=https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip
# No guardar credenciales reales en este archivo.
RTSP_USERNAME=
RTSP_PASSWORD=
