WEB_PORT=8080
RTSP_PORT=8554
PUBLIC_HOST=localhost
TEST_TONE=true
# Para Linux: nombre ALSA, por ejemplo hw:1,0 o default.
AUDIO_DEVICE=
AUDIO_CHANNELS=2
AUDIO_BITRATE=192
MEDIAMTX_VERSION=1.15.2
MEDIAMTX_ARCH=amd64
RTSP_USERNAME=
RTSP_PASSWORD=
# Agente Windows nativo para capturar DirectShow desde la PC anfitriona.
AUDIO_AGENT_URL=http://host.docker.internal:8091
# Debe coincidir con el puerto usado por el agente Windows.
AUDIO_AGENT_PORT=8091
AUDIO_AGENT_TOKEN=
